# Copy this file to .env and fill in your real values.
# .env is ignored by git — never commit it, never paste it in chats or screenshots.

# development | production  (production hides /docs, turns on HSTS, refuses weak secrets)
ENVIRONMENT=development

# PostgreSQL — use a dedicated user that owns only the parkwise database
DATABASE_URL=postgresql+psycopg://parkwise:CHANGE_ME@localhost:5432/parkwise

# Login tokens. Generate a fresh secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay — Dashboard > Settings > API Keys (test keys in development, live keys in production)
# RAZORPAY_KEY_SECRET must NEVER be exposed to the frontend or committed to git.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME

# Gmail app password for password-reset emails (Google Account > Security > App passwords)
SMTP_EMAIL=you@gmail.com
SMTP_APP_PASSWORD=CHANGE_ME

# Where the reset link in the email points
FRONTEND_RESET_URL=http://127.0.0.1:5500/reset-password.html

# Sites allowed to call this API, comma-separated (production: https://parkwise.in,https://www.parkwise.in)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Folder for listing photos (production: /home/parkwise/uploads, outside the code folder)
UPLOAD_DIR=uploads
